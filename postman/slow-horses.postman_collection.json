        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const room = pm.response.json();",
              "pm.test('descends from the original duel', () => {",
              "  pm.expect(room.rematchOfRoomId).to.eql(pm.environment.get('roomId'));",
              "  pm.expect(room.status).to.eql('open');",
              "});",
              "pm.environment.set('rematchRoomId', room.id);",
              "pm.environment.set('rematchInviteCode', room.inviteCode);"
            ]
          }
        }
      ]
    },
