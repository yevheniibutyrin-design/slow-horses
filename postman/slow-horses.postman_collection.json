						"{{baseUrl}}"
					],
					"path": [
						"votes",
						"counts"
					]
				},
				"description": "One request for every card on screen. Anonymous and cacheable: a signed-in reader is served exactly what a signed-out one is.\n\nA market nobody has voted in is not an error — every requested outcome is answered, unknown ones with 0."
			},
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// A market key nobody has voted in, so a re-run does not collide with the",
							"// previous one: one vote per market per identity is permanent.",
							"pm.collectionVariables.set('voteEventId', 'evt-vote-' + Date.now());"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status is 200', () => pm.response.to.have.status(200));",
							"const body = pm.response.json();",
							"pm.test('the body is NOT enveloped', () => {",
							"  pm.expect(body.data, 'a {data:...} envelope makes every field arrive undefined').to.be.undefined;",
							"  pm.expect(body.markets).to.be.an('array');",
							"});",
							"pm.test('an unvoted market answers zeros, not a 404', () => {",
							"  pm.expect(body.markets).to.have.lengthOf(1);",
							"  body.markets[0].outcomes.forEach(o => pm.expect(o.count).to.eql(0));",
							"});",
							"pm.test('votedToday is a number', () => pm.expect(body.votedToday).to.be.a('number'));"
						]
					}
				}
			]
		},
