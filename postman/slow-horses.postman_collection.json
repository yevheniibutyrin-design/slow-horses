						"votes"
					]
				},
				"description": "The write returns the market's fresh counts, which is what lets the client stop optimistically incrementing its own store.\n\nKeys come back EXACTLY as they were sent — the client looks a count up by JSON.stringify of the object it sent, so a reordered or renormalised key misses every lookup and renders zeros on a card that has votes."
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status is 200', () => pm.response.to.have.status(200));",
							"const body = pm.response.json();",
							"pm.test('the counts come back from the write', () => {",
							"  pm.expect(body.outcomes).to.have.lengthOf(2);",
							"  pm.expect(body.outcomes[0].count).to.eql(1);",
							"  pm.expect(body.outcomes[1].count).to.eql(0);",
							"});",
							"pm.test('keys are echoed exactly as sent, in request order', () => {",
							"  pm.expect(body.outcomes[0].key).to.eql({ type: 7, values: ['home'] });",
							"  pm.expect(body.outcomes[1].key).to.eql({ type: 7, values: ['away'] });",
							"});",
							"pm.test('a signed-in caller is not issued a device token', () =>",
							"  pm.expect(body.deviceToken).to.be.undefined);"
						]
					}
				}
			]
		},
