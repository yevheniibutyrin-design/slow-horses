            "rooms",
            "{{rematchRoomId}}",
            "seat"
          ]
        },
        "description": "Carol holds the code and is still refused: a rematch is joinable only by the original opponent, not by whoever opens the link first.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"inviteCode\": \"{{rematchInviteCode}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Rematch seat (bob, the opponent)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bobToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/rooms/{{rematchRoomId}}/seat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "rooms",
            "{{rematchRoomId}}",
            "seat"
          ]
        },
        "description": "Bob was the other participant of the original duel, so the seat is his.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"inviteCode\": \"{{rematchInviteCode}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('rematchHoldId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Release the rematch seat (bob)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bobToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/rooms/{{rematchRoomId}}/seat/{{rematchHoldId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "rooms",
            "{{rematchRoomId}}",
            "seat",
            "{{rematchHoldId}}"
          ]
        },
        "description": "Releasing reopens the seat at once rather than waiting out the TTL. Idempotent: releasing again is still a 204."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get OpenAPI spec (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/openapi.yaml",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "openapi.yaml"
          ]
        },
        "description": "The served spec. Needs no credential."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
