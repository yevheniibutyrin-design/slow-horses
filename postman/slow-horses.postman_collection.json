        ],
        "url": {
          "raw": "{{baseUrl}}/rooms/{{roomId}}/seat/{{holdId}}/confirm",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "rooms",
            "{{roomId}}",
            "seat",
            "{{holdId}}",
            "confirm"
          ]
        },
        "description": "Bob's bet now exists, so the room records it. `odd` and `placement` are the proposed addition for gap G1 \u2014 without them the room cannot record what he actually staked or at what price, and the service cannot derive either, because he is placed at the REPRICED acceptance-time odd.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"participant\": {\n    \"label\": \"Ivan P.\",\n    \"initials\": \"IP\",\n    \"balances\": {\n      \"eur\": 40\n    }\n  },\n  \"betRef\": {\n    \"id\": \"{{joinerBetId}}\",\n    \"number\": 12346\n  },\n  \"odd\": 205,\n  \"placement\": {\n    \"stake\": 8.87,\n    \"lineItemId\": \"li-99\",\n    \"dataVersion\": 9\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const room = pm.response.json();",
              "pm.test('the room is filled with both participants', () => {",
              "  pm.expect(room.status).to.eql('filled');",
              "  pm.expect(room.participants).to.have.lengthOf(2);",
              "});",
              "pm.test('each side carries its OWN stake', () => {",
              "  pm.expect(room.payload.creatorSide.placement.stake).to.eql(10);",
              "  pm.expect(room.payload.opponentSide.placement.stake).to.eql(8.87);",
              "});"
            ]
          }
        }
      ]
    },
