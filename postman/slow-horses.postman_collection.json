				"description": "POST, not GET: the invite code is a join secret and a query string is the one place it must never appear. A code holder who has not taken a seat gets no viewerParticipantId — there is no participant of theirs to name.",
				"body": {
					"mode": "raw",
					"raw": "{\n  \"inviteCode\": \"{{inviteCode}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status is 200', () => pm.response.to.have.status(200));",
							"const room = pm.response.json();",
							"pm.test('a code holder is not yet a participant', () => {",
							"  pm.expect(room.viewerParticipantId).to.be.undefined;",
							"  pm.expect(room.participants).to.have.lengthOf(1);",
							"});"
						]
					}
				}
			]
		},
