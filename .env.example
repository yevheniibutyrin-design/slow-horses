# Copy to .env if you want to override the compose defaults.
# Never commit a real .env.

# The port inside the container is fixed at 5000 (the Dockerfile EXPOSE and the
# compose healthcheck assume it) — change it in docker-compose.yml, not here.

# Host port mapped to it. Override when something already owns 5000 —
# on macOS that is usually AirPlay Receiver (see README, Known gotchas).
API_HOST_PORT=5000

# Mongo connection string. Inside compose this is the service name;
# use mongodb://localhost:27017 only if you reach Mongo from the host.
MONGO_URI=mongodb://mongo:27017

# Database the "rooms" collection lives in. Also drives the seed script's
# target database, so the two cannot drift. Changing it needs `make reseed`,
# because the existing volume will not seed into a new name.
MONGO_DB=slowhorses

# This service's own base URL. Not used for invite links — see
# HOST_EVENT_URL_TEMPLATE below.
PUBLIC_BASE_URL=http://localhost:5000

# --- Authentication -------------------------------------------------------
# HMAC secret for the HS256 bearer tokens this service accepts; the caller is
# the token's `sub` claim.
#
# LEAVE IT UNSET and the server runs in an INSECURE mode where the token itself
# is taken as the caller's identity — `Authorization: Bearer alice` is a user
# called alice, and anyone can impersonate anyone. That exists so local
# development, the smoke script and the Postman collection work without a token
# issuer, and the server logs a warning at startup when it is on.
#
# Set this before the service goes anywhere near production.
# AUTH_JWT_SECRET=change-me

# Browser origins allowed to read responses. Comma-separated, or the single
# value "*" to allow every origin -- the MVP default, so a widget on any host
# can read a room. Narrow it to real origins before this serves anything
# private. Access-Control-Allow-Credentials is never sent, so "*" stays valid.
CORS_ALLOWED_ORIGINS=*

# --- Invite links ---------------------------------------------------------
# Template for a room's inviteUrl. It points at the HOST's event page, NOT at
# this service: the widget reads betRoomId and betRoomInvite off the query
# string once the host has landed the joiner on the event. {eventId} is
# substituted; the two parameters are appended.
HOST_EVENT_URL_TEMPLATE=http://localhost:3000/event/{eventId}

# --- Room lifecycle -------------------------------------------------------
# Standard invite window, measured from a room's creation. A room's expiry is
# clamped to it, and the clamp may only ever shorten what a client asked for.
INVITE_WINDOW_MS=1800000

# How long a reserved seat is held.
#
# UNSIZED. It has to cover a GetOutcomesV2 subscription load PLUS a placement
# round-trip, not a placement alone, and that has never been measured against
# real infrastructure. 90s below is a placeholder, not a sized value — see
# docs/bet-room-api.md §2.2.
SEAT_HOLD_TTL_MS=90000

# --- Duel limits ----------------------------------------------------------
# Maximum stake per duel, as a decimal.
DUEL_PER_DUEL_MAX=500.00
# Duels one caller may open per UTC day. The room service is the only component
# that knows this count, so it is enforced here.
DUEL_DAILY_LIMIT=10
# Currency label reported by GET /rooms/limits.
DUEL_CURRENCY=EUR

# --- Votes ----------------------------------------------------------------
# HMAC secret for the device tokens ANONYMOUS voters are issued, and the key
# the stored address hashes are computed with.
#
# LEAVE IT UNSET and AUTH_JWT_SECRET is used instead. With neither set, a
# secret is generated per process: every issued token stops verifying on
# restart, and each anonymous player may vote again in every market they
# already voted in. The server logs a warning saying exactly that.
#
# ROTATING IT LIFTS BOTH ANONYMOUS LIMITS AT ONCE. It invalidates every issued
# device token, and it also re-keys the stored address hashes — so the per-
# address daily count below starts from zero for everyone as well. Rotate
# deliberately, not routinely.
# VOTE_DEVICE_SECRET=change-me

# Anonymous votes allowed from one address per UTC day. A device token is free
# to discard and re-mint, so this — not the one-vote-per-device rule — is the
# real ceiling on anonymous voting. 0 disables it, leaving it unbounded.
#
# Deliberately not one-vote-per-address: a shared office or carrier NAT puts
# many genuine players behind one address.
VOTE_ANON_IP_DAILY_LIMIT=50

# Forwarded-address header to believe when this service sits behind a proxy.
#
# UNSET BY DEFAULT, which believes none of them: a header any caller can set is
# a header any caller can vary to walk straight past the limit above. Behind a
# proxy this MUST be set, or every player collapses onto the proxy's own
# address and the limit locks the whole site out. Only name a header your own
# proxy overwrites.
# TRUSTED_CLIENT_IP_HEADER=X-Forwarded-For
