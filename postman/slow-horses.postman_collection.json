					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status is 200', () => pm.response.to.have.status(200));",
							"const body = pm.response.json();",
							"pm.test('reports a per-duel max and today\\'s count', () => {",
							"  pm.expect(body.perDuelMax).to.be.a('number');",
							"  pm.expect(body.playedToday).to.be.a('number');",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "1. Create room (alice)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{aliceToken}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/rooms",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"rooms"
					]
				},
				"description": "Alice opens a duel from a bet she has ALREADY placed — betRef is required, because creation places the bet before the room exists. The server derives capacity from the strategy and the figures from the stake and the two prices.",
				"body": {
					"mode": "raw",
					"raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"strategy\": \"duel\",\n  \"participant\": {\n    \"label\": \"Maksym K.\",\n    \"initials\": \"MK\",\n    \"balances\": {\n      \"eur\": 75.5\n    }\n  },\n  \"betRef\": {\n    \"id\": \"{{creatorBetId}}\",\n    \"number\": 12345\n  },\n  \"expiresAt\": {{expiresAt}},\n  \"payload\": {\n    \"marketId\": \"total_goals\",\n    \"marketItemId\": \"total_goals_2.5\",\n    \"creatorSide\": {\n      \"outcomeId\": \"over\",\n      \"odd\": 182,\n      \"placement\": {\n        \"stake\": 10.0,\n        \"lineItemId\": \"li-12\",\n        \"dataVersion\": 7\n      }\n    },\n    \"opponentSide\": {\n      \"outcomeId\": \"under\",\n      \"odd\": 205\n    },\n    \"figures\": {\n      \"payout\": 0,\n      \"entry\": 0,\n      \"pot\": 0\n    }\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				}
			},
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Collection-scoped values, minted once here rather than on the collection:",
							"// a collection-level pre-request script runs before EVERY request, which",
							"// would change eventId between the create and the list that looks for it.",
							"// One bet can belong to at most one room, so every run needs fresh",
							"// references or the second pass hits the idempotency index.",
							"const stamp = Date.now();",
							"pm.environment.set('creatorBetId', 'bet-postman-' + stamp + '-a');",
							"pm.environment.set('joinerBetId', 'bet-postman-' + stamp + '-b');",
							"pm.environment.set('rematchBetId', 'bet-postman-' + stamp + '-c');",
							"pm.environment.set('eventId', 'evt-postman-' + stamp);",
							"// expiresAt is epoch MILLISECONDS, never RFC3339.",
							"pm.environment.set('expiresAt', stamp + 30 * 60 * 1000);"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status is 201', () => pm.response.to.have.status(201));",
							"const room = pm.response.json();",
							"pm.test('body is the room itself, not an envelope', () => {",
							"  pm.expect(room).to.not.have.property('data');",
							"  pm.expect(room.id).to.be.a('string').and.not.empty;",
							"});",
							"pm.test('timestamps are epoch milliseconds', () => {",
							"  pm.expect(room.createdAt).to.be.a('number').and.be.above(1e12);",
							"  pm.expect(room.expiresAt).to.be.a('number').and.be.above(1e12);",
							"});",
							"pm.test('figures are derived: 10.00 at 1.82 vs 2.05', () => {",
							"  pm.expect(room.payload.figures.payout).to.eql(18.2);",
							"  pm.expect(room.payload.figures.entry).to.eql(8.87);",
							"  pm.expect(room.payload.figures.pot).to.eql(18.87);",
							"});",
							"pm.test('the reader is told which participant they are', () => {",
							"  pm.expect(room.viewerParticipantId).to.eql(room.participants[0].id);",
							"});",
							"pm.test('an invite code and a HOST-side link were issued', () => {",
							"  pm.expect(room.inviteCode).to.be.a('string').and.not.empty;",
							"  pm.expect(room.inviteUrl).to.include('betRoomId=' + room.id);",
							"  pm.expect(room.inviteUrl).to.include('betRoomInvite=' + room.inviteCode);",
							"});",
							"pm.environment.set('roomId', room.id);",
							"pm.environment.set('inviteCode', room.inviteCode);"
						]
					}
				}
			]
		},
		{
			"name": "2. Read room (stranger, no code) -> 200 without the secret",
			"request": {
