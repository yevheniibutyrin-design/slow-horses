    {
      "name": "10. Confirm seat (bob)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bobToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
